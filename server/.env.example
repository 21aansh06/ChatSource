# Server API Configuration
PORT=4000

# Postgres Database (Neon Serverless)
DATABASE_URL="postgresql://user:password@ep-cool-db-123456.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Redis Configuration (For BullMQ & caching)
REDIS_URL="redis://default:password@localhost:6379"

# Qdrant Vector DB Cloud
QDRANT_URL="https://your-cluster-id.us-east-4-0.aws.cloud.qdrant.io:6333"
QDRANT_API_KEY="your-qdrant-api-key"

# Cloudflare R2 (S3 Compatible Storage)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="notebooklm-raw-sources"
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"

# Clerk Authentication
CLERK_SECRET_KEY="sk_test_..."
CLERK_PUBLISHABLE_KEY="pk_test_..."
